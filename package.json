{
  "name": "metabolomics-hypothesis-generator",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first workbench for deterministic prioritization of differential metabolomics signals.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test",
    "validate:surface": "node scripts/check_public_surface.mjs",
    "validate:release": "node scripts/validate_release.mjs",
    "check": "npm run test && npm run validate:surface && npm run validate:release && npm run build",
    "audit": "npm audit --audit-level=moderate"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "vite": "^8.1.4"
  },
  "keywords": [
    "metabolomics",
    "hypothesis-prioritization",
    "bioinformatics",
    "local-first",
    "reproducible-research"
  ],
  "license": "MIT"
}
